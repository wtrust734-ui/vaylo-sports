<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect read permissions. These serve /health-sync, which is on
         (`wearableSync: true` in src/config/featureFlags.ts). Health Connect is
         a runtime-consent model: nothing is read until the athlete grants each
         one in the Health Connect permission sheet, which the plugin opens.

         Read-only by design — the app never WRITES into the phone's health
         store. scripts/build-apk.sh fails the release build on any WRITE
         permission, so this set is the complete health surface.

         Google Play requires every HEALTH permission to be actively used and
         declared in the Health Connect declaration (Play Console → App content).
         Keep this list in step with HealthPermissions.READ_PERMISSIONS
         (android/app/src/main/java/com/vaylosports/app/health/HealthPermissions.kt)
         and src/lib/health/permissions.ts; the three are asserted together. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- The app's only non-health permission: every network call (Supabase,
         edge functions, OAuth browser). Declared before <application> in the
         logical order Android lint expects. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 (API 33) made POST_NOTIFICATIONS a runtime permission, and
         posting a notification without it throws SecurityException. It is
         requested by PushPlugin.register(), only once the athlete has
         actually turned a category on in NotificationPrefs. An app that
         asks on first launch, before it has told the athlete what any of
         this is for, is the behaviour Google Play policy calls out.

         This is a real, used permission: VayloMessagingService posts every
         push through it. Below API 33 it is a no-op and is never requested. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect is a separate app on Android 13 (API 33) and below, and from
         API 30 Android hides packages an app has not declared. Without this,
         HealthConnectClient.getSdkStatus() cannot see Health Connect at all, so
         isAvailable() answers false on every Android 11-13 device — precisely the
         range where users still have to install it themselves. Google documents
         this declaration for any app integrating with Health Connect.

         Must stay a direct child of <manifest>, not of <application>. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />

        <!-- Camera capture (CameraCapturePlugin). From API 30 Android hides
             packages an app has not declared, so without this
             PackageManager.resolveActivity(ACTION_IMAGE_CAPTURE) returns null on
             a device that does have a camera app, and capture silently falls
             back to the picker on every phone. The intent target is declared,
             not granted: the photograph is written into our own cache via the
             FileProvider below, so the app needs no CAMERA or storage
             permission to take a photo.

             Must stay a direct child of <manifest>, not of <application>. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <!-- Backup is off: the WebView persists the Supabase session (refresh token)
         in app-private storage, and platform-default backup would upload it to
         Google Drive and carry it across device-to-device transfers. See
         res/xml/data_extraction_rules.xml (API 31+) and full_backup_content.xml
         (API 30 and lower). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect permission rationale (required for Play). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Deep links on the app's own scheme.

                 src/lib/nativeOAuth.ts completes native sign-in from an
                 appUrlOpen event carrying com.vaylosports.app://auth-callback#code=…
                 and strings.xml has always declared custom_url_scheme — but no
                 intent-filter referenced it, so Android had no route to hand the
                 app that URL and the callback could never arrive. Registering the
                 scheme (rather than a specific host) also covers other links that
                 come back on it, such as password recovery. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <!-- Android 14+ permission-usage entry point (opens the privacy policy). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push delivery. FirebaseMessagingService is bound by the
             MESSAGING_EVENT action; the service posts the notification
             itself rather than handing it to the WebView, because a push
             that only renders in JavaScript does not arrive when the app is
             closed or has been swiped away, which is most of the time.

             NOT exported: this entry exists for Firebase to bind, not for
             other apps to start. -->
        <service
            android:name="com.vaylosports.app.push.VayloMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
