<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower equivalent of data_extraction_rules.xml. Older platforms
  still read the `fullBackupContent` attribute, so the same exclusion is
  declared here in the pre-12 schema: Vaylo Sports keeps no restorable local
  state beyond the signed-in session, which must not be copied off the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
