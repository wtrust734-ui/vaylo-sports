<?xml version="1.0" encoding="utf-8"?>
<!--
    Firebase Cloud Messaging configuration.

    These four values come from the Firebase console (Project settings ->
    Your apps -> android com.vaylosports.app -> Download
    google-services.json and read the strings out of it). They are PUBLIC
    client identifiers: they ship inside the APK, which is how the Firebase
    SDK resolves a registration token in the first place.

    PLACEHOLDER: the build was never handed a Firebase project, so every value
    is empty and PushPlugin reports `configured: false`. The prefs screen
    explains why. To turn push on:
      1. Use (or create) the Firebase project the app is already registered
         with, add the Android app with package com.vaylosports.app.
      2. Download google-services.json and copy these four strings out of it.
      3. Rebuild. Nothing else in the app changes: an unconfigured build
         behaves exactly as it did before push existed.
-->
<resources>
    <string name="vaylo_fcm_app_id" translatable="false"></string>
    <string name="vaylo_fcm_api_key" translatable="false"></string>
    <string name="vaylo_fcm_project_id" translatable="false"></string>
    <string name="vaylo_fcm_sender_id" translatable="false"></string>
</resources>
