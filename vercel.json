{
  "name": "vaylo-site",
  "version": 2,
  "builds": [
    {
      "src": "website/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "website/**/*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "website/**/*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/website/index.html" },
    { "src": "/robots.txt", "dest": "/website/robots.txt" },
    { "src": "/site.json", "dest": "/website/site.json" },
    { "src": "/(.*)", "dest": "/website/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
