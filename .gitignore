# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build info (written by `tsc -b`)
*.tsbuildinfo

# Environment — never commit real values. .env.example is the tracked template.
.env
.env.*
!.env.example

# Database dumps / backups. These contain user emails and password hashes.
*.backup
*.dump
*.sql.gz
pg_backup_*

# Supabase CLI working state
.supabase/
supabase/.temp/
supabase/.branches/

# Scratch artifacts from scripts/audit-columns.cjs (a schema dump of column names,
# regenerated on demand — see the script header for the shape it expects)
schema-audit.tmp.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor native build outputs (the project files themselves stay tracked)
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/.xcode.env.local
android/.gradle/
android/build/
android/app/build/
*.keystore
*.jks
