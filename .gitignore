# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build info (written by `tsc -b`)
*.tsbuildinfo

# Environment — never commit real values. .env.example is the tracked template.
.env
.env.*
!.env.example

# Agent scratch space. `ui-audit.local.json` in here holds the Play reviewer
# account's email and password: that account is what Google's testers log in
# with, so committing it would publish a working login. The sync script already
# excludes this directory when copying between the two checkouts, but that is a
# property of the copy tool, not of git — a plain `git add` in this checkout
# would have swept it in. Ignored here so the safety does not depend on
# remembering which script is being run.
.freebuff/

# Database dumps / backups. These contain user emails and password hashes.
*.backup
*.dump
*.sql.gz
pg_backup_*

# Supabase CLI working state
.supabase/
supabase/.temp/
supabase/.branches/

# Scratch artifacts from scripts/audit-columns.cjs (a schema dump of column names,
# regenerated on demand — see the script header for the shape it expects)
schema-audit.tmp.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor native build outputs (the project files themselves stay tracked)
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/.xcode.env.local
android/.gradle/
android/build/
android/app/build/
*.keystore
*.jks

# Sideloadable builds, produced by scripts/build-apk.sh and copied out of
# android/app/build/outputs/. Signed artefacts and 5–7 MB binaries; the real
# output is generated, not tracked. `apksigner` on these is how the upload key
# is checked, and a tracked copy would be one more thing to re-sign whenever the
# key rotates.
apk/
