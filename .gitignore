# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build info (written by `tsc -b`)
*.tsbuildinfo

# Environment — never commit real values. .env.example is the tracked template.
.env
.env.*
!.env.example

# Agent scratch space. `ui-audit.local.json` in here holds the Play reviewer
# account's email and password: that account is what Google's testers log in
# with, so committing it would publish a working login. The sync script already
# excludes this directory when copying between the two checkouts, but that is a
# property of the copy tool, not of git — a plain `git add` in this checkout
# would have swept it in. Ignored here so the safety does not depend on
# remembering which script is being run.
.freebuff/

# Database dumps / backups. These contain user emails and password hashes.
*.backup
*.dump
*.sql.gz
pg_backup_*

# Supabase CLI working state
.supabase/
supabase/.temp/
supabase/.branches/

# Scratch artifacts from scripts/audit-columns.cjs (a schema dump of column names,
# regenerated on demand — see the script header for the shape it expects)
schema-audit.tmp.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor native build outputs (the project files themselves stay tracked)
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/.xcode.env.local
android/.gradle/
android/build/
android/app/build/
*.keystore
*.jks

# Sideloadable builds, produced by scripts/build-apk.sh and copied out of
# android/app/build/outputs/. Signed artefacts and 5–7 MB binaries; the real
# output is generated, not tracked. `apksigner` on these is how the upload key
# is checked, and a tracked copy would be one more thing to re-sign whenever the
# key rotates.
apk/

# Local Netlify folder
.netlify

# Web build of the app (scripts/build-web.cjs). Build output, never committed.
# Note `dist` and `dist-ssr` are listed above; the base name matters to .gitignore,
# so this has to be spelled out.
dist-web

.vercel
.env*
!.env.example

# Generated by `npm run build:clone` — rebuilt, never hand-edited.
webapp-clone/assets/

# Stale copies and scratch trees committed before these rules existed. Each is
# duplicated elsewhere (or nowhere) and none belongs in the tree: `.tools/`
# holds session tokens and scratch scripts, `.ui-backup/` is a pre-refactor
# copy of the component library, `vaylo ad web app/` is a full stale copy of
# this project with its own committed tokens, and `supabase/functions/.bundles/`
# is build output with hardcoded credentials. scripts/sync-to-github.sh runs
# `git add -A` in the repository checkout, so without these rules every sync
# re-commits them.
.tools/
.ui-backup/
vaylo ad web app/
supabase/functions/.bundles/
.preview-session.json
.surf-access-token.txt

# Stray sideload builds at the repository root. The deliberate sideload APKs
# live in public-apk/ (tracked on purpose — the download page serves them);
# these are local build leftovers a sync's `git add -A` would otherwise sweep
# in as multi-megabyte binaries.
/rebuilt-apk/
/vaylo-sports-*.apk
/Vaylo-Sports-*.apk

# CI tees the Gradle output here to surface failures in the step summary
# (job logs need a GitHub sign-in). Never produced by a local build.
android/gradle-build.log
