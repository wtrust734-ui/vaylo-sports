# ============================================================================
# VAYLO SPORTS — ENVIRONMENT
# ----------------------------------------------------------------------------
# Copy to `.env` for development. `.env` is git-ignored; this file is not.
#
# Nothing secret belongs here. Vite inlines every VITE_* value into the public
# frontend bundle, so a key placed here is a published key. Secrets for the
# Supabase Edge Functions are set separately:
#   supabase secrets set OPENAI_API_KEY=... GOOGLE_API=... PAYMENT_MODE=test
# ============================================================================

# --- Read by the frontend (src/integrations/supabase/client.ts) -------------
# Use the project's *publishable* key (sb_publishable_...), not the legacy anon
# JWT. Both are designed to be public and both end up in the APK, but the legacy
# JWT has an `iat` baked in at creation and never rotates, so every build ever
# shipped carries the same key forever. The publishable key can be rotated from
# the Dashboard without touching the app. Settings -> API Keys.
VITE_SUPABASE_URL=https://vvwhausdjzdmsyxekrcl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-4WhrnnT9m8gzQ4nUzPQkg_SE_kevgg

# --- Read by the Supabase CLI / edge runtime locally -----------------------
# (The service-role key must never be given a VITE_ prefix.)
# The edge runtime injects SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# itself, so nothing below is needed to deploy. `supabase db push` and the local
# dev stack do read these two.
SUPABASE_URL=https://vvwhausdjzdmsyxekrcl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_-4WhrnnT9m8gzQ4nUzPQkg_SE_kevgg

# --- Public app URL — optional until an owned canonical domain exists -------
# All public web links require this explicit HTTPS owned domain.
# Local, Supabase, preview and native origins fail closed; native stays linkless.
# VITE_PUBLIC_APP_URL=https://your-owned-domain.example

# --- Project id used by tooling --------------------------------------------
VITE_SUPABASE_PROJECT_ID=vvwhausdjzdmsyxekrcl

# --- Edge function secrets (set with `supabase secrets set`, never here) ---
# SUPABASE_ANON_KEY=          # auto-provided by the Supabase runtime
# SUPABASE_SERVICE_ROLE_KEY=  # auto-provided by the Supabase runtime
# OPENAI_API_KEY=             # ai-service, ai-analyze, generate-plan, weekly-review
# GOOGLE_API=                 # video-form-analysis (Google Generative Language API)
# PAYMENT_MODE=test           # test | store — `store` refuses unverified receipts

# Discord community (leave unset to hide every Discord entry point)
# VITE_DISCORD_INVITE_URL=https://discord.gg/your-permanent-invite

# --- Launch feature flags (optional) ---------------------------------------
# src/config/featureFlags.ts holds the launch decision for each feature and it
# is the default. These variables override a default at build time, so one
# checkout can produce two different builds. Only the literal "true" turns a
# flag on — unset, "0", "false" and typos all leave the default alone, so a
# mistyped variable in CI ships the documented behaviour rather than an
# accidental feature.

#   VITE_ENABLE_wearableSync=true     # Health Connect sheet and its Profile row
#   VITE_ENABLE_gpsTracking=true      # live GPS in Workouts and Routines
#   VITE_ENABLE_coachMarketplace=true # /marketplace and /market/become-creator
#   VITE_ENABLE_iphone=true           # Apple/iPhone surfaces — hidden until an
#                                     # iOS build exists (docs/IPHONE-RELEASE.md)

# Wearable sync also needs vendor OAuth secrets, which do not exist yet — see
# PLAY_STORE.md "Known gaps". Setting the flag before the secrets exist just
# shows a screen full of providers that cannot be connected.

# There is deliberately no AI flag. AI is inside the core pages, so switching it
# off would gut the product rather than hide a feature. Use the server key
# instead:  supabase secrets set OPENAI_API_KEY=sk-...
