# ============================================================================
# VAYLO SPORTS — ENVIRONMENT
# ----------------------------------------------------------------------------
# Copy to `.env` for development. `.env` is git-ignored; this file is not.
#
# Nothing secret belongs here. Vite inlines every VITE_* value into the public
# frontend bundle, so a key placed here is a published key. Secrets for the
# Supabase Edge Functions are set separately:
#   supabase secrets set OPENAI_API_KEY=... GOOGLE_API=... PAYMENT_MODE=test
# ============================================================================

# --- Read by the frontend (src/integrations/supabase/client.ts) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Read by the Supabase CLI / edge runtime locally -----------------------
# (The service-role key must never be given a VITE_ prefix.)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Public app URL — optional on web, needed for a native build -----------
# Shared links, referral links and Supabase auth redirects are built from this.
# Leave it unset in the browser and the current origin is used. Set it before
# building the Capacitor bundle, otherwise links point at capacitor://localhost.
# See CAPACITOR.md §2.
#
# This one belongs in `.env.local`, not here: it differs per deployment and
# `.env.local` is git-ignored and overrides this file. Leaving it commented here
# on purpose, since a value committed to this template would be inherited by
# every checkout, including CI.
# VITE_PUBLIC_APP_URL=https://vaylosports.lovable.app

# --- Project id used by tooling --------------------------------------------
VITE_SUPABASE_PROJECT_ID=

# --- Edge function secrets (set with `supabase secrets set`, never here) ----
# SUPABASE_ANON_KEY=          # auto-provided by the Supabase runtime
# SUPABASE_SERVICE_ROLE_KEY=  # auto-provided by the Supabase runtime
# OPENAI_API_KEY=             # ai-service, ai-analyze, generate-plan, weekly-review
# GOOGLE_API=                 # video-form-analysis (Google Generative Language API)
# PAYMENT_MODE=test           # test | store — `store` refuses unverified receipts

# Discord community (leave unset to hide every Discord entry point)
# VITE_DISCORD_INVITE_URL=https://discord.gg/your-permanent-invite
