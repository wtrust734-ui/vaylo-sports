{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    // node types used to arrive transitively through the old vitest tree; vitest 4
    // no longer provides them, so the test files' node imports need this declared.
    "types": [
      "vitest/globals",
      "node"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/components/_archive",
    "src/lib/profile-upload.ts",
    // The Manus agent's skill skeleton: documentation the external agent reads,
    // never imported by the app and never meant to compile — it references a
    // dependency (type-fest) this project deliberately does not carry and uses
    // shapes the app has no types for. It exists only in the git repository
    // checkout, which is why CI (typechecking that tree) failed while local
    // runs passed. Excluded here rather than deleted so the reference material
    // stays; docs/BUG-AUDIT-2026-10-17.md describes the same arrangement.
    "src/integrations/manus/manus-skill-skeleton.ts"
  ]
}